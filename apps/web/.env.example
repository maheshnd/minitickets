# Copy this file to .env.local (same folder) and adjust if needed.

# Where the browser sends tRPC requests (the API server).
# The NEXT_PUBLIC_ prefix makes the value readable in browser code.
# Leave it empty to use the same origin ("/trpc"), as the AWS image does.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the web SERVER calls the API when it renders a page (server to server, e.g. /events).
# The browser never uses it. No NEXT_PUBLIC_ prefix, so it stays out of browser JavaScript,
# and it is read when a request comes in (not at build time), so one image works everywhere.
# Required: /events shows its error page without it.
API_INTERNAL_URL=http://localhost:4000
