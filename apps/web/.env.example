# Copy this file to .env.local (same folder) and adjust if needed.

# Where the browser sends tRPC requests (the API server).
# The NEXT_PUBLIC_ prefix makes the value readable in browser code.
# Leave it empty to use the same origin ("/trpc"), as the AWS image does.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the web SERVER calls the API when it renders a page (server to server, e.g. /events).
# The browser never uses it. No NEXT_PUBLIC_ prefix, so it stays out of browser JavaScript,
# and it is read when a request comes in (not at build time), so one image works everywhere.
# Required: /events shows its error page without it.
API_INTERNAL_URL=http://localhost:4000

# The shared secret the API must send to POST /api/revalidate (it empties the cached events list
# after an event is created). EXACTLY the same value as REVALIDATE_SECRET in apps/api/.env.
# At least 32 characters; make one with: openssl rand -hex 32 ("CHANGE-ME" is too short on purpose).
# Server only (no NEXT_PUBLIC_), so it never reaches the browser. Without it only the revalidate
# endpoint fails (500); /events still works, and new events show after the 30 s cache lifetime.
REVALIDATE_SECRET=CHANGE-ME
