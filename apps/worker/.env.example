# Copy this file to .env (same folder). The worker reads the jobs queue.

# The queue to read. Locally: the Moto container from docker-compose.yml (`pnpm db:up`).
JOBS_QUEUE_URL=http://localhost:5001/000000000000/minitickets-jobs
# Its dead-letter queue (pnpm tickets:setup). Only `pnpm jobs:dlq` and `pnpm jobs:redrive` use it.
JOBS_DLQ_URL=http://localhost:5001/000000000000/minitickets-jobs-dlq

# Local only: the SDK talks to Moto instead of real SQS. Leave it out on AWS.
SQS_ENDPOINT=http://localhost:5001
AWS_REGION=us-east-1

# The table that remembers finished jobs (duplicates are skipped). Locally: the DynamoDB Local
# container from docker-compose.yml; create the table with `pnpm jobs:table` after `pnpm db:up`.
# Leave DYNAMODB_ENDPOINT out on AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
PROCESSED_JOBS_TABLE=minitickets-processed-jobs

# Dummy credentials: the SDK insists on some, Moto and DynamoDB Local ignore them.
# Never put real keys here.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Which mailer: "log" (default here: a log line, no real email) or "ses" (AWS only: really sends
# through Amazon SES; the Lambda gets MAILER=ses and MAIL_FROM from infra/src/jobs/worker-lambda.ts).
# MAILER=log
# MAIL_FROM=no-reply@minitickets.theversehub.in

# Demo only: make the mailer fail on purpose. "off" (default) | "always" | "first-n:<n>".
# The worker refuses to start with it on when NODE_ENV=production.
# MAILER_FAIL_MODE=first-n:2

# P4: the same worker process polls the second queue independently.
SNS_ENDPOINT=http://localhost:5001
BOOKING_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:minitickets-booking-events
TICKETS_QUEUE_URL=http://localhost:5001/000000000000/minitickets-tickets
TICKETS_DLQ_URL=http://localhost:5001/000000000000/minitickets-tickets-dlq
TICKETS_TABLE=minitickets-tickets
TICKETS_BUCKET=minitickets-ticket-assets
TICKET_SIGNING_SECRET_ID=minitickets/local/ticket-signing
S3_ENDPOINT=http://localhost:5001
SECRETS_MANAGER_ENDPOINT=http://localhost:5001
# The browser origin allowed to upload posters directly (match apps/api/.env WEB_ORIGIN).
WEB_ORIGIN=http://localhost:3000
