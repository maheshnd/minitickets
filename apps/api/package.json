{
  "name": "@minitickets/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "demo:outbox": "tsx --env-file-if-exists=.env src/scripts/outbox-demo.ts",
    "user:make-admin": "tsx --env-file-if-exists=.env src/scripts/make-admin.ts",
    "demo:p4-assets": "tsx --env-file-if-exists=.env src/scripts/p4-assets-demo.ts",
    "demo:search": "tsx --env-file-if-exists=.env src/scripts/search-demo.ts",
    "demo:sale": "tsx --env-file-if-exists=.env src/scripts/sale-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@minitickets/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
