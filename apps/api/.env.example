# Copy this file to .env (same folder) and adjust if needed.

# Port the API listens on.
PORT=4000

# The web app's address. Only this origin may call the API from a browser (CORS).
WEB_ORIGIN=http://localhost:3000

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the values in the root .env (used by docker-compose.yml).
# (On AWS the api gets DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD instead, with SSL.
#  Use one way or the other, never both. See docs/17-infra-ecs-api.md.)
DATABASE_URL=postgres://minitickets:minitickets@localhost:5432/minitickets

# Redis connection string: redis://HOST:PORT (the port must match REDIS_PORT in the root .env).
# Sessions are stored here.
REDIS_URL=redis://localhost:6379

# How many proxies stand in front of the API. Leave it unset locally (default 0: no proxy).
# On AWS the task definition sets 2 (CloudFront + load balancer). See docs/19-infra-cloudfront.md.
# TRUST_PROXY_HOPS=0

# Lowest log level to print: fatal, error, warn, info (default), debug, trace.
# debug also prints one "db query: …" line per events list query (used by `pnpm demo:stampede`).
# LOG_LEVEL=info

# The events list cache (stale-while-revalidate), in milliseconds. SOFT: how long the cached list
# counts as fresh (default 30000). HARD: when Redis deletes it (default 300000 = 5 min).
# Shorten both to watch fresh -> stale -> refresh by hand, e.g. 3000 and 60000.
# EVENTS_CACHE_SOFT_TTL_MS=30000
# EVENTS_CACHE_HARD_TTL_MS=300000

# The web app's revalidate hook: after an event is created, the API asks the web SERVER to drop its
# cached events list (Next.js data cache), so /events shows the new event at once.
# WEB_INTERNAL_URL: the web server's address as the API reaches it (server to server).
# REVALIDATE_SECRET: at least 32 characters, and EXACTLY the same in apps/web/.env.local.
#   Make one with: openssl rand -hex 32   ("CHANGE-ME" is too short on purpose: the API refuses to
#   start until you replace it, so nobody runs with a secret that is printed in this file.)
# Set both or neither. Without them the hook is off (a warning at startup) and a new event shows on
# the server-rendered /events within 30 s instead of at once.
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=CHANGE-ME
