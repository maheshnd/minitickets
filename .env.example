# Copy this file to .env (repo root). docker-compose.yml reads it.
# The values must match DATABASE_URL in apps/api/.env.

POSTGRES_USER=minitickets
POSTGRES_PASSWORD=minitickets
POSTGRES_DB=minitickets

# Host port Redis is published on. 6379 is the Redis default.
# If another Redis already uses 6379 on your machine, pick another (e.g. 6380)
# and use the same port in REDIS_URL in apps/api/.env.
REDIS_PORT=6379
