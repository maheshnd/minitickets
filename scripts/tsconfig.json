// Type-checks the TypeScript scripts in this folder (check-concepts.ts, the demos, ...).
// `pnpm typecheck` runs it after the packages: scripts/ is not a workspace package, so `pnpm -r`
// alone would never look here.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // 1. Node's own modules (node:fs, node:child_process, import.meta.dirname). These types come
    //    from @types/node in the root package.json.
    "types": ["node"],

    // 2. Node runs these files directly by stripping the types, with no build step. It can only
    //    strip syntax that has no runtime effect, so we forbid the rest (enums, namespaces,
    //    constructor parameter properties). tsc then fails BEFORE Node would at run time.
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
