// Shared TypeScript settings. Every package's tsconfig.json "extends" this file.
{
  "compilerOptions": {
    // Turn on all strict type checks (null checks, no implicit any, ...).
    "strict": true,

    // Modern JavaScript output and module syntax (import/export).
    "target": "ES2022",
    "module": "ESNext",
    // Resolve imports the way bundlers and tsx do: no ".js" extensions needed,
    // and package.json "exports" are respected.
    "moduleResolution": "bundler",

    // Each file must be understandable on its own (required by tsx and Next.js).
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Don't type-check library .d.ts files in node_modules (faster, fewer 3rd-party errors).
    "skipLibCheck": true,

    // We only use tsc to CHECK types. tsx (api) and Next.js (web) run the code.
    "noEmit": true
  }
}
