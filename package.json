{
  "name": "minitickets",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm stack:up && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --filter \"./apps/*\" dev",
    "stack:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stack-check.ts",
    "stack:up": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stack-up.ts",
    "stack:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stack-reset.ts",
    "worker:dev": "pnpm --filter @minitickets/worker dev",
    "jobs:table": "pnpm --filter @minitickets/worker jobs:table",
    "jobs:dlq": "pnpm --filter @minitickets/worker jobs:dlq",
    "jobs:redrive": "pnpm --filter @minitickets/worker jobs:redrive",
    "jobs:send": "pnpm --filter @minitickets/worker jobs:send",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "user:make-admin": "pnpm --filter @minitickets/api user:make-admin",
    "app:up": "docker compose --profile app up -d --build --wait",
    "app:down": "docker compose --profile app rm --stop --force api web migrate",
    "test:e2e": "pnpm --filter @minitickets/web test:e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "docs:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-concepts.ts",
    "docs:history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/handbook-history.ts",
    "demo:stampede": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=apps/api/.env scripts/stampede-demo.ts",
    "demo:booking-race": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=apps/api/.env scripts/booking-race-demo.ts",
    "demo:idempotency": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=apps/api/.env scripts/idempotency-demo.ts",
    "demo:outbox": "pnpm --filter @minitickets/api demo:outbox",
    "images:push": "bash scripts/push-images.sh",
    "infra:migrate": "bash scripts/run-migrations.sh",
    "infra:graph": "cd infra && pulumi stack graph deps.dot",
    "tickets:setup": "pnpm --filter @minitickets/worker tickets:setup",
    "demo:tickets": "pnpm --filter @minitickets/worker demo:tickets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
